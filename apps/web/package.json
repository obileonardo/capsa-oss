{
  "name": "capsa-web",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Capsa web app, first version (local data, demo content clearly labelled)",
  "scripts": {
    "predev": "node scripts/features.mjs",
    "dev": "next dev --port 3100 --hostname 127.0.0.1",
    "prebuild": "node scripts/features.mjs",
    "build": "next build",
    "start": "next start --port 3100 --hostname 127.0.0.1",
    "pretypecheck": "node scripts/features.mjs",
    "typecheck": "tsc --noEmit",
    "design-system": "node scripts/build-design-system.mjs",
    "reference-board": "node scripts/build-reference-board.mjs",
    "presandbox": "node scripts/features.mjs",
    "sandbox": "node scripts/sandbox.mjs"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
